# =============================================================
#  AI Trading Agent — متغيّرات البيئة (انسخها لـ .env أو Vercel)
#  المفاتيح هنا تجريبية/فارغة — حط مفاتيحك الحقيقية بنفسك.
#  IMPORTANT: ما ترفعش ملف .env أبداً (هو في .gitignore).
# =============================================================

# ---- العقل (AI) — OpenAI-compatible ----
# المزوّد الافتراضي: openai | groq | openrouter | deepseek | ollama | custom
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
# أقل مستوى ثقة (0..1) لتنفيذ القرار
MIN_CONFIDENCE=0.6

# ---- البروكر الافتراضي ----
# default | binance | bybit | metaapi
DEFAULT_BROKER=binance
# وضع التنفيذ الافتراضي: paper | live
TRADING_MODE=paper

# ---- Binance ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ---- Bybit ----
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# ---- MetaTrader 5 (عبر MetaApi Cloud) ----
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# ---- بيانات السوق الاحتياطية (عامة، بلا مفتاح) ----
# market data fallback: binance | yahoo
MARKET_DATA_SOURCE=binance

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# الدومين بعد النشر على Vercel (بدون شرطة في الآخر)
DEPLOY_URL=

# ---- إدارة المخاطر الافتراضية ----
# حجم الصفقة: نسبة من الرصيد (0.02 = 2%)
RISK_POSITION_PCT=0.02
# أقصى خسارة يومية بالنسبة (0.05 = 5%)
RISK_DAILY_LOSS_PCT=0.05
# أقصى عدد صفقات مفتوحة
RISK_MAX_OPEN_POSITIONS=5
# إيقاف خسارة افتراضي بالنسبة (0.01 = 1%)
RISK_DEFAULT_SL=0.01
# جنى أرباح افتراضي بالنسبة (0.02 = 2%)
RISK_DEFAULT_TP=0.02

# ---- الأزواج والجدولة ----
WATCH_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
AGENT_TIMEFRAME=15m
# تفعيل حلقة العقل التلقائية (cron)
AGENT_AUTORUN=false

# ---- التخزين (Vercel KV اختياري للحالة المستمرّة) ----
# لو متاح، الكود هيستخدمه؛ لو لأ، هيرجع للـ in-memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- أمان الإعدادات server-side ----
# كلمة سر لفتح وضع Live (التنفيذ الحقيقي للأموال)
LIVE_UNLOCK_PASSWORD=
# كلمة سر لقفل/تعديل الإعدادات الحسّاسة (اختياري)
SETTINGS_PASSWORD=
